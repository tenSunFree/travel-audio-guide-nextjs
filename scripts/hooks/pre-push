#!/usr/bin/env bash
# scripts/hooks/pre-push
#
# Before pushing:
#   1. Reject a dirty working tree — including untracked files, since an
#      untracked source or config file can affect `npm run ci` even though
#      it will not actually be pushed — so the CI run below reflects
#      exactly what is about to be pushed.
#   2. Run the full CI pipeline locally (npm run ci).
#
# This is not a perfect substitute for validating the exact pushed refs in
# an isolated worktree, but for a typical checkout -> commit -> push flow
# it removes the most common source of drift between "passes locally" and
# "what actually got pushed".
#
# Install: bash scripts/setup-hooks.sh
# Bypass (not recommended): git push --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

echo ""
echo "pre-push: checking working tree..."

if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    echo ""
    echo "pre-push: working tree has uncommitted or untracked changes."
    echo "Commit, stash, or remove them before pushing, so the CI run below reflects exactly what will be pushed."
    exit 1
fi

echo ""
echo "pre-push: running full CI pipeline (npm run ci)..."
echo ""

if npm run ci; then
    echo ""
    echo "pre-push: All checks passed."
    exit 0
else
    echo ""
    echo "pre-push: CI checks failed, push aborted."
    echo "Fix the issues above, or use 'git push --no-verify' to skip it (not recommended)."
    exit 1
fi