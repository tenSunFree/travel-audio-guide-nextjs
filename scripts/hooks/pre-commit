#!/usr/bin/env bash
# scripts/hooks/pre-commit
#
# Fast checks on staged files only, before every commit:
#   1. Prettier --check on staged, formattable files
#   2. ESLint on staged JS/TS files
#   3. Secret scan on staged changes
#        - gitleaks installed  -> gitleaks git --pre-commit --staged
#        - gitleaks NOT installed -> fallback regex scanner
#
# Full-repo checks (typecheck, tests, build) run in pre-push instead,
# to keep every commit fast.
#
# Install: bash scripts/setup-hooks.sh
# Bypass (not recommended): git commit --no-verify

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1

echo ""
echo "pre-commit: running staged-file checks..."

# ============================================================
# Gather staged files (added/copied/modified, excluding deleted)
# ============================================================
STAGED_ALL_FILES=()
while IFS= read -r -d '' file; do
    STAGED_ALL_FILES+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ ${#STAGED_ALL_FILES[@]} -eq 0 ]; then
    echo "No staged files to check."
    exit 0
fi

# ============================================================
# 1. Prettier (staged files only)
# ============================================================
echo ""
echo "==> prettier (staged files)"

PRETTIER_TARGETS=()
for f in "${STAGED_ALL_FILES[@]}"; do
    [ -f "$f" ] || continue
    case "$f" in
        *.js|*.jsx|*.ts|*.tsx|*.json|*.md|*.mdx|*.scss|*.css|*.yml|*.yaml)
            PRETTIER_TARGETS+=("$f")
            ;;
    esac
done

if [ ${#PRETTIER_TARGETS[@]} -gt 0 ]; then
    if npx prettier --check "${PRETTIER_TARGETS[@]}"; then
        echo "Passed: prettier"
    else
        echo ""
        echo "Unformatted staged file(s) found, commit aborted. Please run:"
        echo "  npx prettier --write ${PRETTIER_TARGETS[*]}"
        echo "  git add -u"
        echo "  git commit"
        exit 1
    fi
else
    echo "No formattable files staged, skipping."
fi

# ============================================================
# 2. ESLint (staged JS/TS files only)
# ============================================================
echo ""
echo "==> eslint (staged files)"

ESLINT_TARGETS=()
for f in "${STAGED_ALL_FILES[@]}"; do
    [ -f "$f" ] || continue
    case "$f" in
        *.js|*.jsx|*.ts|*.tsx)
            ESLINT_TARGETS+=("$f")
            ;;
    esac
done

if [ ${#ESLINT_TARGETS[@]} -gt 0 ]; then
    if npx eslint "${ESLINT_TARGETS[@]}"; then
        echo "Passed: eslint"
    else
        echo ""
        echo "Lint issues found in staged file(s), commit aborted. Please fix:"
        echo "  npx eslint ${ESLINT_TARGETS[*]}"
        exit 1
    fi
else
    echo "No lintable files staged, skipping."
fi

# ============================================================
# 3. secret scan (staged changes)
# ============================================================
echo ""
echo "==> secret scan (staged changes)"

if command -v gitleaks >/dev/null 2>&1; then
    echo "Gitleaks detected. Scanning staged content..."
    echo ""

    if gitleaks git --pre-commit --redact --staged --verbose; then
        echo ""
        echo "Passed: gitleaks scan"
    else
        GITLEAKS_STATUS=$?
        echo ""
        echo "gitleaks detected potentially confidential content (exit code: $GITLEAKS_STATUS), commit aborted."
        echo "If it is confirmed to be a false positive, you can create a .gitleaks.toml file to set an allowlist."
        echo "Or use 'git commit --no-verify' to skip it (not recommended)."
        exit 1
    fi
else
    echo "gitleaks not detected, using the built-in regex fallback scanner instead."
    echo "It is recommended to install gitleaks for a more complete scan:"
    echo "https://github.com/gitleaks/gitleaks#installing"
    echo ""

    SECRET_PATTERN="AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|gh[pousr]_[0-9A-Za-z]{20,}|github_pat_[0-9A-Za-z_]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[0-9A-Za-z]{20,}|-----BEGIN (RSA|DSA|EC|OPENSSH|PRIVATE) KEY-----|(password|passwd|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*[\"'][^\"']{6,}[\"']"

    FOUND_SECRET=0
    for f in "${STAGED_ALL_FILES[@]}"; do
        [ -f "$f" ] || continue

        if ! git diff --cached -- "$f" | grep -Iq .; then
            continue
        fi

        MATCHES=$(git diff --cached -U0 -- "$f" \
            | grep -E '^\+' | grep -vE '^\+\+\+' \
            | grep -EiA0 -- "$SECRET_PATTERN")

        if [ -n "$MATCHES" ]; then
            echo ""
            echo "Possible confidential content: $f"
            echo "$MATCHES" | sed 's/^/    /'
            FOUND_SECRET=1
        fi

        case "$f" in
            *.env|*.env.*|*.pem|*.p12|*.jks|*.keystore|*id_rsa*|*id_ed25519*)
                echo ""
                echo "Submitting a file that looks like a confidential/credential file: $f"
                FOUND_SECRET=1
                ;;
        esac
    done

    if [ "$FOUND_SECRET" -ne 0 ]; then
        echo ""
        echo "The fallback scanner detected potentially confidential content, and the commit was aborted."
        echo "If it is determined to be a false positive, you can use 'git commit --no-verify' to skip it (not recommended)."
        exit 1
    fi

    echo "Passed: fallback secret scan"
fi

echo ""
echo "pre-commit: All checks passed."
exit 0