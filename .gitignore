# ============================================
# dependencies
# ============================================
node_modules
.pnp
.pnp.js

# This project standardizes on npm. Keep only package-lock.json under version control,
# and ignore other package manager lockfiles to prevent accidental use of the wrong tool
# which could create conflicting lockfiles and inconsistent CI/local installs.
yarn.lock
pnpm-lock.yaml
bun.lockb
bun.lock

# ============================================
# Next.js build output
# ============================================
.next/
out/
build/
dist/

# ============================================
# testing
# ============================================
coverage/
.nyc_output/

# ============================================
# environment variables
# ============================================
# The rule should be "deny all, then allow the example file" to avoid accidentally committing
# a raw .env file. That could leak keys/API base URLs. Real values belong in .env.local
# (maintained per environment and not committed).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
next-env.d.ts

# ============================================
# Vercel
# ============================================
.vercel

# ============================================
# logs / debug
# ============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
# editor / IDE
# Personal editor settings should not affect the whole team; however, allow sharing
# recommended team settings in version control.
# ============================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.swp
*.swo

# ============================================
# OS
# ============================================
.DS_Store
Thumbs.db
Desktop.ini

# ============================================
# misc
# ============================================
*.tgz
.turbo